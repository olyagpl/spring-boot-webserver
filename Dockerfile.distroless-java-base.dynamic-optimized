# Distroless Java Base-provides glibc and other libraries needed by the JDK
FROM gcr.io/distroless/java-base-debian12
COPY --from=nativebuild /webserver/target/webserver.dynamic-optimized-upx /
EXPOSE 8000
ENTRYPOINT ["/webserver.dynamic-optimized-upx", "-b", "0.0.0.0", "-d", "/web"]

